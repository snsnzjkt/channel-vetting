# Copy to .env and fill in. .env is gitignored - keep it that way.
#
# Every variable below is read by config.py and nothing else reads env vars,
# so this file is the complete list. In CI the same values are supplied as
# GitHub Actions repository secrets (see .github/workflows/channel-vetting.yml),
# not from a .env file.

# --- Required ---

# Airtable personal access token.
#
# Scope it to the MINIMUM this pipeline needs and nothing more: the single
# base in AIRTABLE_BASE_ID, and within it only the tables actually touched -
# the two niche tables below, the DO NOT CONTACT table, and the other
# YouTube tables external_dedupe.py reads. Scopes: data.records:read +
# data.records:write (schema.bases:read is NOT needed; push_record sends
# field names as-is and never edits schema). This token spends the whole run
# in the environment of a public-repo GitHub Actions job, so a base-wide or
# workspace-wide token turns any compromise of a dependency or an action
# into write access to everything in the workspace.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# One table per niche - table name or table ID both work.
AIRTABLE_TABLE_HOME_THEATER=
AIRTABLE_TABLE_LIFESTYLE_SOFA=
# YouTube Data API v3 key. Restrict it to the YouTube Data API in the Google
# Cloud console; the free tier is 10,000 quota units/day and that ceiling is
# the pipeline's main operational constraint.
YOUTUBE_API_KEY=

# --- Optional overrides (defaults shown) ---
# QUOTA_CEILING=8000
# API_SLEEP_SECONDS=0.5

# Optional: extra pages of older uploads scanned for a contact email when
# the free steps find nothing. 2 quota units per page, per channel. 0 disables.
# EMAIL_DEEP_SCAN_PAGES=2

# Optional: enable the Playwright + stealth link-list email lookup
# (default false locally; the GitHub Actions workflow turns it ON for
# scheduled runs and lets a manual dispatch uncheck it).
# USE_PLAYWRIGHT_STEALTH=false
# Backward-compatible alias still accepted:
# USE_CLOAKBROWSER=false
#
# Note: CLOAKBROWSER_LICENSE_KEY is no longer used by anything. The
# cloakbrowser-mcp .mcp.json entry that interpolated it has been removed and
# no Python module reads it - drop it from any existing .env.

# Optional: timezone defining a "prospect day" for the daily caps. Pinned
# rather than host-local on purpose - see "Time zones" in CLAUDE.md. Requires
# the tzdata package on Windows (pinned in requirements.txt).
# PROSPECT_DAY_TZ=America/Toronto
# Optional: max qualified/flagged prospects pushed per niche per day.
# DAILY_QUALIFIED_CAP=30
# DAILY_FLAGGED_CAP=10
# Optional: multiple of remaining headroom to bank in fresh candidates.
# CANDIDATE_OVERSHOOT=1.5
# Optional: how far back search.list looks for videos, in days. Overridable
# per run with --days-back (and via the workflow's days_back input, which is
# validated as digits-only).
# DISCOVERY_DAYS_BACK=7
