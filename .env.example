AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# One table per niche — table name or table ID both work.
AIRTABLE_TABLE_HOME_THEATER=
AIRTABLE_TABLE_LIFESTYLE_SOFA=
YOUTUBE_API_KEY=

# Optional: last-resort email-finder fallback (Hunter.io Domain Search).
