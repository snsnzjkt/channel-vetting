# Copy to .env and fill in. .env is gitignored - keep it that way.
#
# Every variable below is read by config.py and nothing else reads env vars,
# so this file is the complete list. In CI the same values are supplied as
# GitHub Actions repository secrets (see .github/workflows/channel-vetting.yml),
# not from a .env file.

# --- Required ---

# Airtable personal access token.
#
# Scope it to the MINIMUM this pipeline needs and nothing more: the single
# base in AIRTABLE_BASE_ID, and within it only the tables actually touched -
# the two niche tables below, the DO NOT CONTACT table, and the other
# YouTube tables external_dedupe.py reads. Scopes: data.records:read +
# data.records:write (schema.bases:read is NOT needed; push_record sends
# field names as-is and never edits schema). This token spends the whole run
# in the environment of a public-repo GitHub Actions job, so a base-wide or
# workspace-wide token turns any compromise of a dependency or an action
# into write access to everything in the workspace.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# One table per niche - table name or table ID both work.
AIRTABLE_TABLE_HOME_THEATER=
AIRTABLE_TABLE_LIFESTYLE_SOFA=
# YouTube Data API v3 key. Restrict it to the YouTube Data API in the Google
# Cloud console; the free tier is 10,000 quota units/day and that ceiling is
# the pipeline's main operational constraint.
YOUTUBE_API_KEY=

# --- Optional overrides (defaults shown) ---
# QUOTA_CEILING=8000
# API_SLEEP_SECONDS=0.5

# Optional: extra pages of older uploads scanned for a contact email when
# the free steps find nothing. 2 quota units per page, per channel. 0 disables.
# EMAIL_DEEP_SCAN_PAGES=2

# Optional: enable the Playwright + stealth link-list email lookup
# (default false locally; the GitHub Actions workflow turns it ON for
# scheduled runs and lets a manual dispatch uncheck it).
# USE_PLAYWRIGHT_STEALTH=false
# Backward-compatible alias still accepted:
# USE_CLOAKBROWSER=false
#
# Note: CLOAKBROWSER_LICENSE_KEY is no longer used by anything. The
# cloakbrowser-mcp .mcp.json entry that interpolated it has been removed and
# no Python module reads it - drop it from any existing .env.

# Optional: timezone defining a "prospect day" for the daily caps. Pinned
# rather than host-local on purpose - see "Time zones" in CLAUDE.md. Requires
# the tzdata package on Windows (pinned in requirements.txt).
# PROSPECT_DAY_TZ=America/Toronto
# Optional: max qualified/flagged prospects pushed per niche per day.
# DAILY_QUALIFIED_CAP=30
# DAILY_FLAGGED_CAP=10
# Optional: multiple of remaining headroom to bank in fresh candidates per
# discovery round. Batch sizing only - run_niche() refills until the
# qualified cap is met or the keywords run out, so this no longer limits how
# many rows a day can produce.
# CANDIDATE_OVERSHOOT=1.5
# Optional: unique channels one keyword is expected to yield (measured ~42 at
# max_results=50 over 7 days). Only converts a row shortfall into a keyword
# count for the next discovery round.
# EXPECTED_CANDIDATES_PER_KEYWORD=40
# Optional: extra pages of older uploads paged through to confirm a channel has
# 30+ videos that are NOT Shorts, and only for channels whose newest 50 fell
# short. 2 quota units per page. 0 judges on the newest 50 alone.
# LONGFORM_SCAN_MAX_PAGES=3
# Optional: how far back search.list looks for videos, in days. Overridable
# per run with --days-back (and via the workflow's days_back input, which is
# validated as digits-only).
# DISCOVERY_DAYS_BACK=7

# --- influencers.club (email chain step 4) ---
# Resolves a YouTube channel ID to a validated contact address. Unset means
# step 4 is skipped entirely and the chain falls through to the browser
# step, so this is optional - the pipeline runs without it.
# INFLUENCERS_API_KEY=
# Optional: override the API host.
# INFLUENCERS_BASE_URL=https://api-dashboard.influencers.club
# Optional: hard cap on lookups per run, bounding credit spend the way
# LONGFORM_SCAN_MAX_PAGES bounds quota spend. Only channels the free steps
# missed consume one, and a lookup that finds no address is not billed.
# INFLUENCERS_MAX_LOOKUPS_PER_RUN=100

# --- influencers.club discovery (creator search - replaces search.list) ---
# Uses the same INFLUENCERS_API_KEY above. When a key is set, discovery
# sources candidates from influencers.club creator search (filtered on the
# niche's criteria server-side) instead of YouTube search.list. With no key,
# discovery falls back to search.list, so this is optional.
# Optional: per-run credit ceiling for discovery. Discovery costs 0.01
# credits per creator RETURNED; this bounds a runaway, not normal use.
# Lowered from 50 to 6 on 2026-08-14 - 50 credits is 5,000 creators, and a
# live run spent 16 for ONE qualified row before anyone noticed.
# INFLUENCERS_MAX_DISCOVERY_CREDITS_PER_RUN=6
# Optional: --test gets its own much tighter discovery ceiling. The row caps
# alone do NOT bound discovery spend and in fact make it worse: a small cap
# shrinks the target, the target never drops below the vendor's 50-result
# minimum billable page, so each round buys 50 creators to examine 3. One
# page per niche is all a smoke test needs.
# INFLUENCERS_TEST_DISCOVERY_CREDITS=1

# --- Credit ledger: the ceilings that survive the process ---
# Every ceiling above is PER-RUN and lives on an object, so it vanishes with
# the process: two runs on the same day each got a full allowance, and nothing
# could report a monthly total. credit_tracker.py persists spend to a local
# JSON ledger and enforces the two ceilings below ACROSS runs - the same
# protection quota_log.json gives free YouTube quota, applied to the one spend
# that is real money.
#
# Optional: where the ledger lives. Gitignored, machine-local; committing it
# would merge two machines' spend into one nonsense total.
# CREDIT_LOG_FILE=credit_log.json
# Optional: daily ceiling. A measured full two-niche day is ~7.3 credits
# (5.5 discovery + 1.8 email), so 10 covers that plus a small manual top-up
# while stopping a second full run from silently doubling it.
# INFLUENCERS_MAX_CREDITS_PER_DAY=10
# Optional: monthly ceiling - the brake in front of the vendor's FAIR-USE cap,
# which resets only at subscription renewal and which no retry clears.
# !! CHECK THIS AGAINST YOUR ACTUAL SUBSCRIPTION. !! The API does not expose
# the plan's allowance or its renewal date, so the 200 default is derived from
# measured usage (22 weekday runs x ~7.3), NOT from the real entitlement. If
# your plan is smaller, this default would authorise spending past the real cap.
# INFLUENCERS_MAX_CREDITS_PER_MONTH=200

# --- Outreach: review-to-send system ---

# DEMO MODE. Defaults to TRUE, and leave it that way until the outreach
# prerequisites are signed off (dedicated warmed sending domain, CAN-SPAM/PECR
# footer, confirmed Gmail auth). Setting this to "false" is the moment this
# project starts emailing real creators; a cold email cannot be recalled.
#
# It is a SEPARATE gate from --dry-run on purpose. --dry-run lives on the
# command line, one copied README command away from being overridden. This
# lives in the environment, so leaving demo mode takes a deliberate edit.
# The send path must clear both.
# OUTREACH_DEMO_MODE=true
# In demo mode every message is redirected here regardless of the prospect's
# real address, so a rehearsal exercises the true send path without a creator
# receiving anything. UNSET means demo mode refuses to send at all — that is
# deliberate: a missing test address must never fall back to the real one.
# OUTREACH_DEMO_RECIPIENT=

# Airtable tables created 2026-08-14. config.py carries these IDs as defaults,
# so they only need setting to point at a different base (e.g. a staging copy).
# AIRTABLE_TABLE_OUTREACH_LOG=tblcKnLKAbdjUCH68
# AIRTABLE_TABLE_AUDIT_TRAIL=tblTjGTRHCAEnq2qq
# AIRTABLE_TABLE_OUTREACH_LOCK=tbldWjtDW8EOCT0V2
# AIRTABLE_TABLE_HOME_THEATER_OUTREACH=tblOChqk6iVlRxwkp
# AIRTABLE_TABLE_LIFESTYLE_SOFA_OUTREACH=tblk6Tml6PO90wLZz

# Sends per PROSPECT DAY, counted from the Outreach Log rather than tracked
# locally — a per-run cap is not a cap, since five runs before lunch at 50
# each is 250 emails.
# OUTREACH_DAILY_CAP=10
# OUTREACH_MAX_PER_RUN=10
# OUTREACH_SLEEP_SECONDS=2
# A claim unsettled this long MAY have been delivered; --reconcile surfaces it
# for a human. Never auto-retried.
# OUTREACH_STRANDED_AFTER_MINUTES=60
# Advisory lease take-over threshold. The Outreach Lock row is NOT a mutex
# (Airtable has no conditional writes) — real serialisation is the GitHub
# Actions concurrency group on .github/workflows/outreach.yml.
# OUTREACH_LEASE_STALE_MINUTES=60

# Follow-up ("respam"): re-contact a NON-replier months later. Bounded by both
# a minimum age and a hard ceiling on total touches. Prior Sent rows ARE the
# counter, so the ceiling cannot be reset by editing a field.
# OUTREACH_RESPAM_MIN_DAYS=90
# OUTREACH_MAX_TOUCHES=2

# --- Outreach mail transport (required before --send will start) ---
# No defaults anywhere below: --send refuses to start without them, which
# turns "we forgot the unsubscribe link" from a legal exposure into a startup
# failure nobody can skip.
# GMAIL_SENDER_EMAIL=            # on the DEDICATED sending domain, never the corporate one
# GMAIL_CREDENTIALS_B64=         # base64 of the service-account/OAuth JSON. Base64 rather
#                                #   than a path because CI cannot supply a file, and a
#                                #   private key should not be written to a runner's disk.
# OUTREACH_FOOTER_TEXT=          # postal address — CAN-SPAM
# OUTREACH_UNSUBSCRIBE_URL=      # opt-out — CAN-SPAM / PECR

# --- Gemini relevance verification (FREE TIER ONLY) ---
#
# THE COST GUARANTEE IS NOT IN THE CODE. Per Google's API terms the Gemini API is
# a "Paid Service" *only* when reached through a Cloud project with an ACTIVE
# BILLING ACCOUNT. Mint this key in a project that has none and a charge is
# structurally impossible: an over-quota request returns 429 and is not billed.
# No API reports billing status, so nothing in this repo can check it for you.
#   1. https://aistudio.google.com/apikey -> Create API key -> in a NEW project
#   2. https://console.cloud.google.com/billing/linkedaccount?project=YOUR_PROJECT
#      must read "This project has no billing account."   <- that sentence IS it
#   3. Restrict the key to the Generative Language API. It sits in the Actions
#      job env next to AIRTABLE_TOKEN for the whole run.
#   4. Re-check step 2 after every rotation.
#
# Also worth knowing: the free tier is "Unpaid Services" under those terms, so
# Google may train on and human-review what is submitted. What this pipeline
# submits is a public YouTube URL, public titles/descriptions, and your own
# niche criteria — never a creator's email and never Airtable data.
# GEMINI_API_KEY=

# Off by default. Only the literal "false" disables a default-true flag and only
# the literal "true" enables a default-false one (see config.env_flag), so a typo
# leaves the safe value in place rather than silently flipping a cost guard.
# GEMINI_ENABLED=false
# GEMINI_FREE_ONLY=true

# Must be one of GEMINI_FREE_TIER_MODELS in config.py, which is hardcoded on
# purpose — an operator-overridable allowlist is not an allowlist. Anything else
# switches verification off for the whole run with a loud error, rather than
# quietly substituting a model you did not ask for.
# Allowed: gemini-3.7-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite

# The endpoint. Override only to point at a local stub in a test.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Longer than any other timeout here because Google fetches and decodes the
# YouTube segment server-side before the model sees a frame. One retry, and only
# for 5xx/network — never for a 429 (that is the free-tier wall, and retrying it
# is the one behaviour this integration must not have).
# GEMINI_TIMEOUT=60
# GEMINI_MAX_RETRIES=1

# PROVISIONAL — the one threshold here with no measurement behind it yet.
# "Relevance Detail" records the confidence on every verdict; after ~2 weeks set
# this just below the lowest confidence a human reviewer agreed with. Raising it
# only converts rescues into non-rescues, never into drops, so it is safe to move
# in either direction.
# GEMINI_MIN_CONFIDENCE=0.6

# Request ceilings, per PROCESS (main.run loops all niches in one) and per
# Pacific day (Google's quota day, not the prospect day). The VIDEO caps are the
# only ones that touch the free tier's 8h/day YouTube allowance; the text tier is
# bounded by tokens alone. MAX_GEMINI_REQUESTS_PER_RUN / _PER_DAY are accepted as
# aliases, but the GEMINI_-prefixed names are canonical.
# GEMINI_MAX_REQUESTS_PER_RUN=300
# GEMINI_MAX_VIDEO_REQUESTS_PER_RUN=60
# GEMINI_MAX_REQUESTS_PER_DAY=600
# GEMINI_MAX_VIDEO_REQUESTS_PER_DAY=120

# Wall-clock brake. Must stay below the workflow's timeout-minutes: a killed run
# prints no run summary at all, which is the least legible failure available.
# GEMINI_MAX_SECONDS_PER_RUN=900

# Which 25 seconds. Not the opening — that is intro, branding and the sponsor
# read. At least 90s in, or 25% through for longer uploads, whichever is later.
# GEMINI_CLIP_SECONDS=25
# GEMINI_CLIP_MIN_START_SECONDS=90
# GEMINI_CLIP_START_FRACTION=0.25

# Local state. Both are gitignored; gemini_cache.json holds model text about
# named creators. Bump GEMINI_VERDICT_VERSION to invalidate every cached verdict
# by hand after a prompt or threshold change.
# GEMINI_LOG_FILE=gemini_log.json
# GEMINI_CACHE_FILE=gemini_cache.json
# GEMINI_CACHE_RETENTION_DAYS=30
# GEMINI_VERDICT_VERSION=1
