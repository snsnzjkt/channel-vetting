# Optional: Modash creator-database email lookup (modash_backfill.py).
# Get one at https://marketer.modash.io/developer. Metered — 1 credit per
# channel looked up. Leave blank to disable.
MODASH_API_KEY=

# Optional overrides (defaults shown)
# QUOTA_CEILING=8000
